# Credenciales de Google (copia este archivo a .env.local y completa los valores).
# Todas son variables públicas: se incluyen en el bundle, no pongas secretos aquí.

# --- Android y Web ---
# ID de cliente OAuth de tipo "Web" creado en Google Cloud Console.
# Se usa para pedir el id token y el access token de Google Drive.
# Formato: 000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- iOS ---
# ID de cliente OAuth de tipo "iOS" creado en Google Cloud Console.
# Obligatorio en iOS: la librería no puede inferirlo del URL scheme.
# Formato: 000000000000-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
